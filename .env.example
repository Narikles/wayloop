# =============================================================================
# Configuration de WayLoop. Copiez ce fichier en .env, ou lancez :
#   python3 scripts/init_env.py     (génère .env avec des clés aléatoires)
# =============================================================================

# --- Général ------------------------------------------------------------------
APP_NAME=WayLoop
# dev : premier essai en local · prod : en ligne (clés obligatoires, pas de lien affiché à l'écran)
ENVIRONMENT=dev
# Adresse publique de l'application (liens envoyés par e-mail, pages candidats).
PUBLIC_BASE_URL=http://localhost:8000
# Affiche le lien de connexion à l'écran au lieu de l'envoyer seulement par e-mail. JAMAIS en production.
DEMO_MODE=true
# 32 caractères aléatoires minimum.
SECRET_KEY=a-remplacer
# Clé de chiffrement des CV et données candidats. NE PAS PERDRE : sans elle, les CV sont illisibles.
STORAGE_ENCRYPTION_KEY=a-remplacer
POSTGRES_PASSWORD=a-remplacer

# --- E-mail ---------------------------------------------------------------------
# smtp vers Mailpit (http://localhost:8025) pour tester ; remplacez par votre fournisseur en production.
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=WayLoop <no-reply@votre-domaine.fr>

# --- Diffusion automatique des offres -------------------------------------------
# Google pour l'emploi : chaque offre est publiée avec ses données structurées et listée
# dans /sitemap.xml (rien à configurer). Déclarez ce plan du site dans Google Search Console.
# Facultatif : compte de service Google (chemin du fichier JSON, ou son contenu) pour signaler
# chaque publication et chaque clôture à l'API d'indexation (prise en compte plus rapide).
GOOGLE_INDEXING_CREDENTIALS=
# Plateformes qui reprennent les offres par flux XML (/feeds/<id>.xml), une fois l'accord passé
# avec chacune : identifiants séparés par des virgules, ex. jooble,talent,adzuna
PUBLICATION_FEEDS=
# Durée de validité affichée aux moteurs de recherche (jours), prolongée tant que l'offre est ouverte.
JOB_VALIDITY_DAYS=60

# --- Abonnement (offres Gratuit, Pro et Agence) --------------------------------
# demo : changement d'offre immédiat, sans paiement (essais, démonstration)
# stripe : paiement réel (Stripe Checkout + portail client) · disabled : offre gratuite seulement
BILLING_MODE=demo
STRIPE_SECRET_KEY=
# Secret du point de terminaison webhook : https://<votre-domaine>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix récurrents créés dans Stripe (price_…) : Pro et Agence, mensuel et annuel.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
STRIPE_TRIAL_DAYS=14
STRIPE_AUTOMATIC_TAX=false
# Prix affichés dans l'application (HT) : à aligner sur ceux configurés dans Stripe.
PRICE_MONTHLY_EUR=25
PRICE_YEARLY_EUR=240
PRICE_AGENCY_MONTHLY_EUR=79
PRICE_AGENCY_YEARLY_EUR=756

# --- Assistant de rédaction (facultatif) ----------------------------------------
# Une phrase -> brouillon d'offre, critères et 3 questions. Sans clé : mode « règles », sans IA.
# Seule la phrase du dirigeant est envoyée au fournisseur, jamais une donnée de candidat.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# Brouillons par entreprise et par jour.
AI_DAILY_LIMIT=30

# --- Candidatures reçues par e-mail (facultatif) --------------------------------
# Chaque offre reçoit l'adresse offres+<code>@domaine ; la boîte doit accepter le sous-adressage.
INBOUND_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Automatisations ------------------------------------------------------------
# Délai pendant lequel un refus peut être annulé avant l'envoi du remerciement (minutes).
AUTO_REJECT_DELAY_MINUTES=60
RELANCE_DAYS_DEFAULT=3
# Récapitulatif hebdomadaire : jour (0 = lundi) et heure de Paris.
WEEKLY_RECAP_WEEKDAY=0
WEEKLY_RECAP_HOUR=8

# --- Règles métier -------------------------------------------------------------
# Le salaire est toujours demandé dans le formulaire. Ce réglage rend aussi bloquante, dans le texte
# retouché à la main, l'absence de fourchette (directive (UE) 2023/970, en cours de transposition).
SALARY_RANGE_REQUIRED=false
# Conservation des candidatures après le dernier contact (mois), appliquée d'office.
RETENTION_MONTHS_AFTER_LAST_CONTACT=24
RETENTION_DAYS_AFTER_HIRE=90
AUDIT_RETENTION_DAYS=1095
